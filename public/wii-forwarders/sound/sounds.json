    "sequencing": "nw4r SeqPlayer tick clock, MML parser, envelope and channel math, as in the 4.3 decompilation",
    "voices": "AX voice: 16.16 sample-rate conversion, 96-sample volume ramps, integer mixing",
    "effect": "AXFX ReverbHi on auxiliary A (fused mode 0, 2.5 s, coloration 0.5, as System::initFx sets it), returned two frames after the send",
    "stereoWaves": "each channel of a stereo wave plays on its own side at unity (CalcAXPBMIX), not centered",
    "converter": "4-tap filter banks from a DSP coefficient ROM dump",
    "approximations": [
      "reverb arithmetic is double precision where the console uses single precision",
      "randomized pitch bend is rendered at its middle value",
      "surround pan is ignored; the page is stereo"
    ],
    "dspCoefSha256": "d7741279c2e8ec5c5fb318f8fbdd6de6bf583520d288e836a5383233a4238179"
  },
